# Copy to .env (gitignored) or export these in the shell that runs the engine.

# Lead sourcing. Required by pipeline/apollo_pull.py; without it, sourcing is skipped.
APOLLO_API_KEY=

# Where the Gmail OAuth client_secret.json and token.json live. Optional: defaults to
# ~/.config/outreach-engine/. Keep this OUTSIDE the repo - it holds a refresh token that can
# send mail as you.
OUTREACH_GMAIL_DIR=

# The engine's own local timezone, used to anchor the daily chain. Defaults to
# America/New_York if unset.
LOCAL_TZ=America/New_York
